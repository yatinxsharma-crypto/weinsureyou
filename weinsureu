<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Fill Details</title>

<style>
*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,sans-serif;
}

body{
background:#09021d;
display:flex;
justify-content:center;
align-items:center;
height:100vh;
overflow:hidden;
color:white;
}

.card{
text-align:center;
background:rgba(0,255,100,0.08);
padding:40px 30px;
border-radius:20px;
box-shadow:0 0 25px rgba(0,255,100,0.4);
width:350px;
}

button{
background:#00cc44;
color:white;
border:none;
padding:18px 35px;
font-size:28px;
border-radius:50px;
cursor:pointer;
box-shadow:0 0 20px #00ff66;
transition:0.3s;
}

button:hover{
transform:scale(1.05);
}

#prank{
display:none;
margin-top:30px;
animation:pop 0.6s ease;
}

#prank h1{
font-size:65px;
margin-bottom:15px;
}

#prank p{
font-size:28px;
font-weight:bold;
}

@keyframes pop{
from{
transform:scale(0.5);
opacity:0;
}
to{
transform:scale(1);
opacity:1;
}
}
</style>
</head>

<body>

<div class="card">
<button onclick="showPrank()">📝 Fill Details</button>

<div id="prank">
<h1>😂🤣😂🤣</h1>
<p>Got you! This is a prank 😜</p>
</div>
</div>

<script>
function showPrank(){
document.getElementById("prank").style.display="block";
}
</script>

</body>
</html>
